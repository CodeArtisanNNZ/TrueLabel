<div class="max-w-4xl mx-auto space-y-6">
  <a href="/catalog/product/{{product.id}}" class="text-sm text-slate-600 hover:underline">&larr; Back to product</a>
  <header class="bg-white border border-slate-200 rounded-lg p-6">
    <p class="text-xs font-bold uppercase text-slate-500">{{product.brand}}</p>
    <h1 class="text-2xl font-black text-slate-900 mt-1">Reviews for {{product.name}}</h1>
    <div class="mt-2 font-bold">{{#if averageRating}}Credibility-weighted average: {{averageRating}} / 5{{else}}No ratings yet{{/if}}</div>
    <p class="text-xs text-slate-500 mt-2">Consumer opinions are not a food-safety assessment. Unverified purchases do not receive an evidence bonus.</p>
  </header>

  {{#if canReview}}
    <form method="POST" action="/community/products/{{product.id}}/reviews" class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">
      <h2 class="text-lg font-bold">Write a review</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <label class="text-sm font-semibold">Taste and quality (1–5)<input type="number" name="tasteRating" min="1" max="5" value="3" required class="block mt-1 w-full border border-slate-300 rounded p-2"></label>
        <label class="text-sm font-semibold">Label accuracy (1–5)<input type="number" name="labelAccuracyRating" min="1" max="5" value="3" required class="block mt-1 w-full border border-slate-300 rounded p-2"></label>
        <label class="text-sm font-semibold">Packaging condition (1–5)<input type="number" name="packagingRating" min="1" max="5" value="3" required class="block mt-1 w-full border border-slate-300 rounded p-2"></label>
        <label class="text-sm font-semibold">Purchase experience (1–5)<input type="number" name="purchaseExperienceRating" min="1" max="5" value="3" required class="block mt-1 w-full border border-slate-300 rounded p-2"></label>
      </div>
      <label class="block text-sm font-semibold">Title (optional)<input name="title" maxlength="120" class="mt-1 block w-full border border-slate-300 rounded p-2"></label>
      <label class="block text-sm font-semibold">Your experience<textarea name="comment" minlength="10" maxlength="2000" rows="4" required class="mt-1 block w-full border border-slate-300 rounded p-2"></textarea></label>
      <button type="submit" class="bg-slate-900 text-white font-semibold rounded px-4 py-2 text-sm">Submit review</button>
    </form>
  {{else}}
    {{#if alreadyReviewed}}<p class="text-sm text-slate-600">You have already reviewed this product. You can edit or remove your review below.</p>{{/if}}
    {{#unless user}}<p class="text-sm"><a class="underline font-semibold" href="/auth/login">Sign in</a> as a consumer to add a review.</p>{{/unless}}
  {{/if}}

  <section class="space-y-3">
    <h2 class="text-lg font-bold">Customer reviews ({{reviews.length}})</h2>
    {{#each reviews}}
      <article class="bg-white border border-slate-200 rounded-lg p-5 space-y-3">
        <div class="flex items-center justify-between gap-3">
          <span class="text-sm font-bold">{{this.authorName}} <span class="font-normal text-slate-500">{{this.postedOn}}</span></span>
          <span class="font-bold text-sm">{{this.rating}} / 5</span>
        </div>
        {{#if this.title}}<h3 class="font-bold">{{this.title}}</h3>{{/if}}
        <p class="text-sm text-slate-600">Taste {{this.tasteRating}} · Label {{this.labelAccuracyRating}} · Packaging {{this.packagingRating}} · Purchase {{this.purchaseExperienceRating}}</p>
        <p class="text-sm whitespace-pre-wrap">{{this.comment}}</p>
        <div class="text-xs text-slate-500">Credibility weight: {{this.credibilityWeight}}</div>
        {{#if this.manufacturerReply}}<div class="bg-slate-50 p-3 border-l-2 border-slate-400"><b>Manufacturer reply:</b> {{this.manufacturerReply}}</div>{{/if}}
        {{#if this.isMine}}
          <details class="pt-2">
            <summary class="text-xs font-bold cursor-pointer text-slate-700">Edit my review</summary>
            <form method="POST" action="/community/reviews/{{this.id}}/edit" class="space-y-3 mt-3">
              <div class="grid grid-cols-2 gap-3 text-sm">
                <label>Taste<input name="tasteRating" type="number" min="1" max="5" value="{{this.tasteRating}}" required class="block mt-1 border w-full p-2 rounded"></label>
                <label>Label accuracy<input name="labelAccuracyRating" type="number" min="1" max="5" value="{{this.labelAccuracyRating}}" required class="block mt-1 border w-full p-2 rounded"></label>
                <label>Packaging<input name="packagingRating" type="number" min="1" max="5" value="{{this.packagingRating}}" required class="block mt-1 border w-full p-2 rounded"></label>
                <label>Purchase<input name="purchaseExperienceRating" type="number" min="1" max="5" value="{{this.purchaseExperienceRating}}" required class="block mt-1 border w-full p-2 rounded"></label>
              </div>
              <label class="text-sm block">Title<input name="title" maxlength="120" value="{{this.title}}" class="block mt-1 border w-full p-2 rounded"></label>
              <label class="text-sm block">Comment<textarea name="comment" minlength="10" maxlength="2000" required class="block mt-1 border w-full p-2 rounded">{{this.comment}}</textarea></label>
              <button type="submit" class="px-3 py-2 text-sm text-white bg-slate-900 rounded">Save review</button>
            </form>
          </details>
          <form action="/community/reviews/{{this.id}}/delete" method="POST" onsubmit="return confirm('Delete your review?');">
            <button class="text-xs text-rose-700 font-semibold" type="submit">Delete my review</button>
          </form>
        {{/if}}
        {{#if this.canReply}}
          <form method="POST" action="/community/reviews/{{this.id}}/reply" class="space-y-2">
            <label class="text-xs font-semibold block">Manufacturer response<textarea name="reply" required minlength="2" maxlength="1000" class="block w-full p-2 border rounded mt-1">{{this.manufacturerReply}}</textarea></label>
            <button type="submit" class="text-xs font-semibold px-3 py-2 bg-slate-900 text-white rounded">Save response</button>
          </form>
        {{/if}}
      </article>
    {{else}}
      <div class="bg-white border rounded p-5 text-sm text-slate-500">No reviews yet.</div>
    {{/each}}
  </section>
</div>
