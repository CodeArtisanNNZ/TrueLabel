<div class="max-w-4xl mx-auto space-y-8 py-4">

  <!-- Breadcrumbs & Document Header -->
  <div class="space-y-2">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
      <a href="/" class="hover:text-slate-900 transition-colors">&larr; Back to Home</a>
      <span>/</span>
      <span class="text-slate-700">Support & Communications</span>
    </div>
    <div class="flex items-center gap-2 pt-1">
      <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-300">
        Inquiries Desk
      </span>
      <span class="text-xs text-slate-400 font-mono">Response Window: 24–48 Hours</span>
    </div>
    <h1 class="font-serif text-3xl sm:text-4xl text-slate-950 tracking-tight pt-1">
      Contact & Regulatory Inquiries
    </h1>
    <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-3xl">
      Reach out to the TrueLabel Standards Committee, submit reports regarding inaccurate food label declarations, or inquire about official manufacturer verification and laboratory integration.
    </p>
  </div>

  <!-- Emergency Clinical Callout -->
  <div class="p-4 rounded-xl bg-rose-50 border border-rose-300 text-xs text-rose-950 flex items-start gap-3">
    <div class="w-6 h-6 rounded-full bg-rose-600 text-white flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">
      !
    </div>
    <div>
      <div class="font-bold uppercase tracking-wider text-[11px] text-rose-900">Medical Emergency Notice</div>
      <p class="text-rose-900 mt-0.5 leading-relaxed">
        TrueLabel is a technical transparency registry and does not provide emergency medical assistance. If you or a family member are experiencing acute symptoms of an anaphylactic allergic reaction, contact national emergency medical services or visit the nearest emergency medical facility immediately.
      </p>
    </div>
  </div>

  <!-- Communication Desks Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-2 text-xs">
      <div class="text-[11px] font-bold uppercase tracking-wider text-emerald-700">Consumer Inquiries</div>
      <h3 class="text-base font-black text-slate-950 tracking-tight">Public Health Desk</h3>
      <p class="text-slate-600">Assistance with dietary profile setup, allergen conflict warnings, or general transparency queries.</p>
      <div class="pt-2 font-mono text-slate-900 font-semibold">consumer@truelabel.org</div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-2 text-xs">
      <div class="text-[11px] font-bold uppercase tracking-wider text-blue-700">Commercial Brands</div>
      <h3 class="text-base font-black text-slate-950 tracking-tight">Manufacturer Desk</h3>
      <p class="text-slate-600">Onboarding packaged products, submitting trade licences, and resolving document audit rejection notes.</p>
      <div class="pt-2 font-mono text-slate-900 font-semibold">compliance@truelabel.org</div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-2 text-xs">
      <div class="text-[11px] font-bold uppercase tracking-wider text-amber-700">Standards & Audits</div>
      <h3 class="text-base font-black text-slate-950 tracking-tight">Inspector & Regulators</h3>
      <p class="text-slate-600">Regulatory liaison for BSTI, BFSA, and certified laboratory accreditation testing authorities.</p>
      <div class="pt-2 font-mono text-slate-900 font-semibold">standards@truelabel.org</div>
    </div>
  </div>

  <!-- Report Form Card -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm space-y-6">
    <div class="border-b border-slate-100 pb-4">
      <h2 class="text-xl font-black text-slate-950 tracking-tight">Send an Inquiry or Report Mislabeled Packaging</h2>
      <p class="text-xs text-slate-500 mt-1">Submit your message directly to our platform team. All submissions are logged for quality assurance.</p>
    </div>

    <form class="space-y-4 text-xs" onsubmit="event.preventDefault(); document.getElementById('contact-success').classList.remove('hidden'); this.reset();">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-bold uppercase tracking-wider text-slate-700 mb-1">Your Full Name *</label>
          <input type="text" required placeholder="e.g. Dr. Aminul Islam" value="{{user.name}}" class="w-full text-sm px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none">
        </div>
        <div>
          <label class="block font-bold uppercase tracking-wider text-slate-700 mb-1">Email Address *</label>
          <input type="email" required placeholder="aminul@example.com" value="{{user.email}}" class="w-full text-sm px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-bold uppercase tracking-wider text-slate-700 mb-1">Inquiry Department *</label>
          <select required class="w-full text-sm px-3.5 py-2.5 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-emerald-600 focus:outline-none">
            <option value="report">Report Inaccurate Ingredient / Mislabeled Food</option>
            <option value="licence">Manufacturer Licence & Certification Support</option>
            <option value="consumer">Consumer Dietary Profile Assistance</option>
            <option value="other">General Platform & Research Inquiry</option>
          </select>
        </div>
        <div>
          <label class="block font-bold uppercase tracking-wider text-slate-700 mb-1">Associated Barcode / Food Name (Optional)</label>
          <input type="text" placeholder="e.g. 9312345678901 / Organic Oat Milk" class="w-full text-sm px-3.5 py-2.5 rounded-lg border border-slate-300 font-mono focus:ring-2 focus:ring-emerald-600 focus:outline-none">
        </div>
      </div>

      <div>
        <label class="block font-bold uppercase tracking-wider text-slate-700 mb-1">Your Message or Detailed Report *</label>
        <textarea required rows="4" placeholder="Provide full details, batch numbers, or packaging observations..." class="w-full text-sm p-3.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none"></textarea>
      </div>

      <div id="contact-success" class="hidden p-3.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold">
        ✓ Your report has been dispatched to the TrueLabel Standards Desk. Reference ID: <span class="font-mono">TL-REQ-2026</span>.
      </div>

      <div class="pt-2">
        <button type="submit" class="px-6 py-2.5 rounded-lg bg-slate-950 text-white font-bold text-xs uppercase tracking-wider hover:bg-slate-800 transition-colors shadow-sm">
          Dispatch Inquiry
        </button>
      </div>
    </form>
  </div>

  <!-- Footer Actions -->
  <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-200 text-xs">
    <div class="text-slate-500">
      Need to verify an accreditation? <a href="/safety/licence/verify" class="text-emerald-700 font-bold hover:underline">Open Official Licence Registry</a>.
    </div>
    <div class="flex items-center gap-3">
      <a href="/terms" class="text-slate-700 hover:text-slate-950 font-medium">Terms of Service &rarr;</a>
      <a href="/privacy" class="text-slate-700 hover:text-slate-950 font-medium">Privacy Policy &rarr;</a>
    </div>
  </div>

</div>
