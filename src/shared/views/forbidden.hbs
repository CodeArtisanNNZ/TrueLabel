<div class="max-w-lg mx-auto my-16 bg-white p-8 border border-slate-200 rounded-xl shadow-sm text-center">
  <div class="w-14 h-14 bg-rose-100 text-rose-700 rounded-full flex items-center justify-center mx-auto mb-4">
    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
  </div>

  <span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-rose-50 text-rose-700 border border-rose-200 mb-2">
    HTTP 403 · Access Denied
  </span>

  <h1 class="text-2xl font-black text-slate-900 tracking-tight">Access Restricted</h1>
  <p class="text-sm text-slate-600 mt-2 mb-6">
    {{#if message}}
      {{message}}
    {{else}}
      Your current account role does not have authorization to view or perform operations on this resource.
    {{/if}}
  </p>

  {{#if user}}
    <div class="text-xs text-slate-500 bg-slate-50 rounded-lg p-3 border border-slate-200 mb-6 text-left">
      <div class="font-bold text-slate-700">Authenticated Identity:</div>
      <div class="mt-0.5 font-mono">{{user.name}} ({{user.email}})</div>
      <div class="mt-1">
        Current Role: <span class="font-bold uppercase text-slate-900">{{user.role}}</span>
      </div>
    </div>
  {{/if}}

  <div class="flex items-center justify-center gap-3">
    <a
      href="/catalog"
      class="px-4 py-2 bg-slate-900 text-white rounded-lg font-bold text-xs hover:bg-slate-800 transition-colors"
    >
      Return to Food Catalog
    </a>
    <a
      href="/"
      class="px-4 py-2 border border-slate-300 text-slate-700 rounded-lg font-bold text-xs hover:bg-slate-100 transition-colors"
    >
      TrueLabel Home
    </a>
  </div>
</div>
